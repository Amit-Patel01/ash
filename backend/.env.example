# Backend Environment Variables
PORT=5000

# ───── Email ─────
RESEND_API_KEY=your_resend_api_key_here

# ───── Razorpay ─────
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ───── Firebase Storage ─────
# Enable Firebase Storage in Firebase Console, then add the bucket URL:
# Format: your-project-id.appspot.com
FIREBASE_STORAGE_BUCKET=solutionhub-81976.appspot.com

# Firebase Admin service account JSON as a single-line string.
# Use this on Render/VPS instead of committing credentials.json.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id","private_key_id":"your-private-key-id","private_key":"-----BEGIN PRIVATE KEY-----\\nYOUR_PRIVATE_KEY\\n-----END PRIVATE KEY-----\\n","client_email":"firebase-adminsdk@your-project-id.iam.gserviceaccount.com","client_id":"your-client-id"}

# ───── AI (Gemini) ─────
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ───── Security ─────
# Optional: used for additional JWT signing if needed
JWT_SECRET=your_jwt_secret_here

# Comma-separated frontend origins allowed to call the backend directly.
# On Vercel, the frontend can use same-domain /api rewrites, so this is mainly
# for local development or direct backend access.
ALLOWED_ORIGINS=https://www.amitsolutionhub.com,https://amitsolutionhub.com,http://localhost:5173,http://127.0.0.1:5173
